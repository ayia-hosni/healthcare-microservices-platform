diff --git a/infra/k8s/overlays/k3s/platform/nginx-ingress.yaml b/infra/k8s/overlays/k3s/platform/nginx-ingress.yaml
new file mode 100644
index 0000000..28a0908
--- /dev/null
+++ b/infra/k8s/overlays/k3s/platform/nginx-ingress.yaml
@@ -0,0 +1,32 @@
+# F5 NGINX Ingress Controller, installed by k3s's built-in Helm controller (no helm CLI
+# needed). This is NGINX's own controller, not the community ingress-nginx project, which was
+# retired in March 2026 and no longer gets security fixes.
+#
+# Service type LoadBalancer is picked up by k3s's ServiceLB, which binds ports 80/443 on the
+# VPS itself. Requires k3s to be installed with --disable=traefik so those ports are free.
+apiVersion: helm.cattle.io/v1
+kind: HelmChart
+metadata:
+  name: nginx-ingress
+  namespace: kube-system
+spec:
+  repo: https://helm.nginx.com/stable
+  chart: nginx-ingress
+  version: 2.7.3 # controller 5.6.3
+  targetNamespace: nginx-ingress
+  createNamespace: true
+  valuesContent: |-
+    controller:
+      ingressClass:
+        name: nginx
+        create: true
+      service:
+        type: LoadBalancer
+        externalTrafficPolicy: Local
+      config:
+        entries:
+          server-tokens: "False"
+      resources:
+        requests:
+          cpu: 100m
+          memory: 128Mi
diff --git a/infra/k8s/overlays/k3s/secrets.env.example b/infra/k8s/overlays/k3s/secrets.env.example
new file mode 100644
