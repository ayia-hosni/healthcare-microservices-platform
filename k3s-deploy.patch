@@ -0,0 +1,138 @@
+# Stand-in for the external insurance payer billing-service's PayerEligibilityClient calls —
+# see docs/adr/0003-soap-payer-eligibility-integration.md. Mapping/response files below are
+# the same content docker-compose.yml mounts directly from infra/docker/payer-mock/ — inlined
+# here rather than referenced by path (same pattern as postgres-initdb's copy of
+# infra/docker/init-multiple-dbs.sh) since kustomize's default load restrictions don't allow
+# a configMapGenerator to read files outside this kustomization's own directory tree.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: payer-mock-mappings
+  namespace: healthcare-platform
+data:
+  eligible-default.json: |
+    {
+      "priority": 10,
+      "request": {
+        "method": "POST",
+        "urlPath": "/ws",
+        "headers": {
+          "SOAPAction": { "contains": "CheckEligibility" }
+        }
+      },
+      "response": {
+        "status": 200,
+        "headers": { "Content-Type": "text/xml;charset=UTF-8" },
+        "bodyFileName": "eligible-response.xml"
+      }
+    }
+  ineligible-member.json: |
+    {
+      "priority": 1,
+      "request": {
+        "method": "POST",
+        "urlPath": "/ws",
+        "headers": {
+          "SOAPAction": { "contains": "CheckEligibility" }
+        },
+        "bodyPatterns": [
+          { "contains": "<memberId>MEMBER-INELIGIBLE</memberId>" }
+        ]
+      },
+      "response": {
+        "status": 200,
+        "headers": { "Content-Type": "text/xml;charset=UTF-8" },
+        "bodyFileName": "ineligible-response.xml"
+      }
+    }
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: payer-mock-files
+  namespace: healthcare-platform
+data:
+  eligible-response.xml: |
+    <?xml version="1.0" encoding="UTF-8"?>
+    <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+      <soap:Body>
+        <checkEligibilityResponse xmlns="http://payer.example.com/eligibility/v1">
+          <eligible>true</eligible>
+          <planName>Gold PPO 500</planName>
+          <copayAmount>25.00</copayAmount>
+          <payerMessage>Active coverage confirmed (simulated payer-mock response).</payerMessage>
+        </checkEligibilityResponse>
+      </soap:Body>
+    </soap:Envelope>
+  ineligible-response.xml: |
+    <?xml version="1.0" encoding="UTF-8"?>
+    <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+      <soap:Body>
+        <checkEligibilityResponse xmlns="http://payer.example.com/eligibility/v1">
+          <eligible>false</eligible>
+          <payerMessage>No active coverage found for this member (simulated payer-mock response).</payerMessage>
+        </checkEligibilityResponse>
+      </soap:Body>
+    </soap:Envelope>
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: payer-mock
+  namespace: healthcare-platform
+  labels:
+    app: payer-mock
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: payer-mock
+  template:
+    metadata:
+      labels:
+        app: payer-mock
+    spec:
+      enableServiceLinks: false
+      containers:
+        - name: payer-mock
+          image: wiremock/wiremock:3.9.1
+          ports:
+            - containerPort: 8080
+          volumeMounts:
+            - name: mappings
+              mountPath: /home/wiremock/mappings
+            - name: response-files
+              mountPath: /home/wiremock/__files
+          readinessProbe:
+            httpGet:
+              path: /__admin/mappings
+              port: 8080
+            initialDelaySeconds: 5
+            periodSeconds: 10
+          resources:
+            requests:
+              cpu: "50m"
+              memory: "128Mi"
+            limits:
+              cpu: "250m"
+              memory: "256Mi"
+      volumes:
+        - name: mappings
+          configMap:
+            name: payer-mock-mappings
+        - name: response-files
+          configMap:
+            name: payer-mock-files
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: payer-mock
+  namespace: healthcare-platform
+spec:
+  selector:
+    app: payer-mock
+  ports:
+    - port: 8080
+      targetPort: 8080
+  type: ClusterIP
diff --git a/infra/k8s/overlays/k3s/datastores/postgres.yaml b/infra/k8s/overlays/k3s/datastores/postgres.yaml
new file mode 100644
index 0000000..2779b45
--- /dev/null
+++ b/infra/k8s/overlays/k3s/datastores/postgres.yaml
@@ -0,0 +1,163 @@
+# Single-node k3s Postgres. Same shape as the dev overlay, but passwords come from
+# platform-secrets (generated into ../secrets.env by deploy-to-k3s.sh) instead of being
+# hardcoded, and the volume is sized for real use. k3s's local-path provisioner backs the PVC
+# with a directory on the VPS disk.
+#
+# The init script only runs against an EMPTY data directory. Changing DB_PASSWORD after the
+# first boot does not change the roles' passwords — rotate them with ALTER ROLE, or wipe the
+# PVC on a throwaway install.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: postgres-initdb
+  namespace: healthcare-platform
+data:
+  # Same script infra/docker/init-multiple-dbs.sh runs for docker-compose: one database +
+  # owning user per microservice, all sharing platform-secrets' DB_PASSWORD.
+  01-init-multiple-dbs.sh: |
+    #!/usr/bin/env bash
+    set -euo pipefail
+
+    create_database_and_user() {
+    	local db=$1
+    	local user=$2
+    	local password=$3
+
+    	echo "Creating database '$db' owned by '$user'"
+    	psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" <<-EOSQL
+    		DO \$\$
+    		BEGIN
+    			IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '$user') THEN
+    				CREATE ROLE $user LOGIN PASSWORD '$password';
+    			END IF;
+    		END
+    		\$\$;
+    		SELECT 'CREATE DATABASE $db OWNER $user' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '$db')\gexec
+    		GRANT ALL PRIVILEGES ON DATABASE $db TO $user;
+    	EOSQL
+
+    	psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$db" <<-EOSQL
+    		CREATE EXTENSION IF NOT EXISTS pgcrypto;
+    	EOSQL
+    }
+
+    if [ -n "${POSTGRES_MULTIPLE_DATABASES:-}" ]; then
+    	echo "Multiple database creation requested: $POSTGRES_MULTIPLE_DATABASES"
+    	IFS=',' read -ra ENTRIES <<< "$(echo "$POSTGRES_MULTIPLE_DATABASES" | tr -d '[:space:]')"
+    	for entry in "${ENTRIES[@]}"; do
+    		IFS=':' read -r db user password <<< "$entry"
+    		create_database_and_user "$db" "$user" "$password"
+    	done
+    	echo "Multiple databases created"
+    fi
+---
+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: postgres-data
+  namespace: healthcare-platform
+spec:
+  accessModes: ["ReadWriteOnce"]
+  resources:
+    requests:
+      storage: 10Gi
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: postgres
+  namespace: healthcare-platform
+  labels:
+    app: postgres
+spec:
+  replicas: 1
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: postgres
+  template:
+    metadata:
+      labels:
+        app: postgres
+    spec:
+      enableServiceLinks: false
+      containers:
+        - name: postgres
+          image: postgres:16-alpine
+          ports:
+            - containerPort: 5432
+          env:
+            - name: POSTGRES_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: platform-secrets
+                  key: POSTGRES_SUPERUSER_PASSWORD
+            - name: DB_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: platform-secrets
+                  key: DB_PASSWORD
+            - name: PGDATA
+              value: /var/lib/postgresql/data/pgdata
+            # $(DB_PASSWORD) is expanded by the kubelet from the env var above. The init
+            # script splits on ':' and ',', so the password must not contain either (the
+            # generated hex passwords don't).
+            - name: POSTGRES_MULTIPLE_DATABASES
+              value: >-
+                identity_db:identity_user:$(DB_PASSWORD),
+                patient_db:patient_user:$(DB_PASSWORD),
+                doctor_db:doctor_user:$(DB_PASSWORD),
+                appointment_db:appointment_user:$(DB_PASSWORD),
+                emr_db:emr_user:$(DB_PASSWORD),
+                billing_db:billing_user:$(DB_PASSWORD),
+                notification_db:notification_user:$(DB_PASSWORD),
+                audit_db:audit_user:$(DB_PASSWORD),
+                analytics_db:analytics_user:$(DB_PASSWORD)
+          volumeMounts:
+            - name: data
+              mountPath: /var/lib/postgresql/data
+            - name: initdb
+              mountPath: /docker-entrypoint-initdb.d
+          readinessProbe:
+            exec:
+              command: ["pg_isready", "-U", "postgres"]
+            initialDelaySeconds: 10
+            periodSeconds: 5
+            timeoutSeconds: 5
+            failureThreshold: 6
+          livenessProbe:
+            exec:
+              command: ["pg_isready", "-U", "postgres"]
+            initialDelaySeconds: 30
+            periodSeconds: 15
+            timeoutSeconds: 5
+            failureThreshold: 6
+          resources:
+            requests:
+              cpu: "100m"
+              memory: "256Mi"
+            limits:
+              cpu: "1000m"
+              memory: "1Gi"
+      volumes:
+        - name: data
+          persistentVolumeClaim:
+            claimName: postgres-data
+        - name: initdb
+          configMap:
+            name: postgres-initdb
+            defaultMode: 0755
+---
+apiVersion: v1
