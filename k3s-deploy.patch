@@ -0,0 +1,20 @@
+# Keys expected in secrets.env (gitignored). deploy-to-k3s.sh generates this file with random
+# values on first run — you only need to create it by hand if you want specific values.
+# Values must not contain ':' or ',' (Postgres init script splits on them).
+JWT_SECRET=
+DB_PASSWORD=
+POSTGRES_SUPERUSER_PASSWORD=
+RABBITMQ_USER=notification_service
+RABBITMQ_PASSWORD=
+MINIO_ROOT_USER=emr-minio
+MINIO_ROOT_PASSWORD=
+# Unused while Kafka runs PLAINTEXT, but application.yml still needs them to resolve.
+KAFKA_SASL_PASSWORD_IDENTITY=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_PATIENT=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_DOCTOR=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_APPOINTMENT=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_EMR=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_BILLING=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_NOTIFICATION=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_AUDIT=unused-kafka-is-plaintext
+KAFKA_SASL_PASSWORD_ANALYTICS=unused-kafka-is-plaintext
diff --git a/infra/k8s/scripts/deploy-to-k3s.sh b/infra/k8s/scripts/deploy-to-k3s.sh
new file mode 100755
index 0000000..dbe579e
--- /dev/null
+++ b/infra/k8s/scripts/deploy-to-k3s.sh
@@ -0,0 +1,192 @@
+#!/usr/bin/env bash
+# Deploys the platform to a single-node k3s VPS behind the F5 NGINX Ingress Controller, with
+# a Let's Encrypt certificate from cert-manager. Run on the VPS, as root, from the repo root:
+#
+#   DOMAIN=health.example.com ACME_EMAIL=you@example.com ./infra/k8s/scripts/deploy-to-k3s.sh
+#
+# Safe to re-run: it's also the redeploy command after pulling new code.
+#
+# Optional env:
+#   ACME_STAGING=1   use Let's Encrypt staging (untrusted cert, no rate limits) while testing
+#   SKIP_BUILD=1     don't build; expects images already imported under IMAGE_TAG
+#   IMAGE_TAG=...    defaults to the current git short SHA
+set -euo pipefail
+
+: "${DOMAIN:?Set DOMAIN, e.g. DOMAIN=health.example.com (its A record must point at this VPS)}"
+: "${ACME_EMAIL:?Set ACME_EMAIL, used for the ACME account and certificate expiry notices}"
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+OVERLAY="$REPO_ROOT/infra/k8s/overlays/k3s"
+SECRETS_FILE="$OVERLAY/secrets.env"
+GENERATED="$REPO_ROOT/infra/k8s/.generated/k3s"
+export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
+
+SERVICES=(
+  identity-service patient-service doctor-service appointment-service emr-service
+  billing-service notification-service audit-service analytics-service graphql-gateway
+)
+
+if [[ $EUID -ne 0 ]]; then
+  echo "Run as root (sudo -E keeps DOMAIN/ACME_EMAIL)." >&2
+  exit 1
+fi
+
+wait_for_deploy() {
+  local ns=$1 name=$2
+  echo "    waiting for $ns/$name"
+  for _ in $(seq 1 90); do
+    kubectl -n "$ns" get deploy "$name" >/dev/null 2>&1 && break
+    sleep 5
+  done
+  kubectl -n "$ns" rollout status "deploy/$name" --timeout=300s
+}
+
+echo "==> k3s"
+if ! command -v k3s >/dev/null 2>&1; then
+  # Traefik is disabled so the NGINX Ingress Controller can own ports 80/443.
+  curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable=traefik" sh -
+fi
+kubectl wait --for=condition=Ready node --all --timeout=180s
+if kubectl -n kube-system get deploy traefik >/dev/null 2>&1; then
+  echo "Traefik is running and holds ports 80/443. Add 'disable: [traefik]' to" >&2
+  echo "/etc/rancher/k3s/config.yaml, run 'systemctl restart k3s', then re-run this script." >&2
+  exit 1
+fi
+
+echo "==> NGINX Ingress Controller + cert-manager"
+kubectl apply -f "$OVERLAY/platform/"
+wait_for_deploy nginx-ingress nginx-ingress-controller
+wait_for_deploy cert-manager cert-manager
+wait_for_deploy cert-manager cert-manager-webhook
+
+echo "==> Let's Encrypt ClusterIssuer"
+if [[ "${ACME_STAGING:-0}" == "1" ]]; then
+  ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
+else
+  ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
+fi
+# The webhook can take a few seconds after rollout to start serving; retry until it accepts.
+for attempt in $(seq 1 12); do
+  if kubectl apply -f - <<EOF
+apiVersion: cert-manager.io/v1
+kind: ClusterIssuer
+metadata:
+  name: letsencrypt
+spec:
+  acme:
+    server: $ACME_SERVER
+    email: $ACME_EMAIL
+    privateKeySecretRef:
+      name: letsencrypt-account-key
+    solvers:
+      - http01:
+          ingress:
+            ingressClassName: nginx
+EOF
+  then break; fi
+  [[ $attempt -eq 12 ]] && { echo "cert-manager webhook never became ready" >&2; exit 1; }
+  sleep 5
+done
+
+echo "==> Secrets"
+if [[ ! -f "$SECRETS_FILE" ]]; then
+  rand() { openssl rand -hex "${1:-24}"; }
+  umask 077
+  {
+    echo "JWT_SECRET=$(rand 32)"
+    echo "DB_PASSWORD=$(rand)"
+    echo "POSTGRES_SUPERUSER_PASSWORD=$(rand)"
+    echo "RABBITMQ_USER=notification_service"
+    echo "RABBITMQ_PASSWORD=$(rand)"
+    echo "MINIO_ROOT_USER=emr-minio"
+    echo "MINIO_ROOT_PASSWORD=$(rand)"
+    for svc in IDENTITY PATIENT DOCTOR APPOINTMENT EMR BILLING NOTIFICATION AUDIT ANALYTICS; do
+      echo "KAFKA_SASL_PASSWORD_${svc}=unused-kafka-is-plaintext"
+    done
+  } > "$SECRETS_FILE"
+  echo "    generated $SECRETS_FILE — back it up; Postgres is initialised with these passwords"
+else
+  echo "    using existing $SECRETS_FILE"
+fi
+
+echo "==> Images"
+if [[ -z "${IMAGE_TAG:-}" ]]; then
+  IMAGE_TAG="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || date +%Y%m%d%H%M%S)"
+  # Uncommitted changes would otherwise reuse the last commit's tag and never roll out.
+  if ! git -C "$REPO_ROOT" diff --quiet HEAD 2>/dev/null; then
+    IMAGE_TAG="${IMAGE_TAG}-dirty-$(date +%Y%m%d%H%M%S)"
+  fi
+fi
+echo "    tag: $IMAGE_TAG"
+
+if [[ "${SKIP_BUILD:-0}" != "1" ]]; then
+  command -v docker >/dev/null 2>&1 || {
+    echo "Docker is needed to build images: curl -fsSL https://get.docker.com | sh" >&2
+    exit 1
+  }
+  export DOCKER_BUILDKIT=1
+  IMAGES=()
+  for svc in "${SERVICES[@]}"; do
+    echo "--> $svc"
+    # --provenance=false: attestation manifests make 'k3s ctr images import' fail.
+    docker build --provenance=false -q -t "healthcare-platform/$svc:$IMAGE_TAG" \
+      -f "$REPO_ROOT/backend/$svc/Dockerfile" "$REPO_ROOT/backend"
+    IMAGES+=("healthcare-platform/$svc:$IMAGE_TAG")
+  done
+  echo "--> frontend"
+  docker build --provenance=false -q -t "healthcare-platform/frontend:$IMAGE_TAG" "$REPO_ROOT/frontend"
+  IMAGES+=("healthcare-platform/frontend:$IMAGE_TAG")
+
+  echo "    importing into k3s containerd"
+  TAR="$(mktemp --suffix=.tar)"
+  docker save -o "$TAR" "${IMAGES[@]}"
+  k3s ctr images import "$TAR"
+  rm -f "$TAR"
+fi
+
+echo "==> Applying overlay"
+mkdir -p "$GENERATED"
+{
+  cat <<EOF
+# Generated by deploy-to-k3s.sh — per-deploy values layered on the k3s overlay. Gitignored.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - ../../overlays/k3s
+images:
+EOF
+  for img in "${SERVICES[@]}" frontend; do
+    printf '  - name: healthcare-platform/%s\n    newTag: "%s"\n' "$img" "$IMAGE_TAG"
+  done
+  cat <<EOF
+patches:
+  - target: { kind: Ingress, name: platform-gateway }
+    patch: |-
+      - op: add
+        path: /spec/rules/0/host
+        value: "$DOMAIN"
+      - op: add
+        path: /spec/tls
+        value:
+          - hosts: ["$DOMAIN"]
+            secretName: platform-tls
+  - target: { kind: ConfigMap, name: platform-config }
+    patch: |-
+      - op: add
+        path: /data/CORS_ALLOWED_ORIGINS
+        value: "https://$DOMAIN"
+EOF
+} > "$GENERATED/kustomization.yaml"
+
+kubectl apply -k "$GENERATED"
+
+echo "==> Waiting for workloads (cold start: expect a few restarts while Postgres/Kafka/MinIO come up)"
+kubectl -n healthcare-platform wait --for=condition=available deployment --all --timeout=900s \
+  || echo "    not all ready yet: kubectl -n healthcare-platform get pods"
+
+echo "==> Waiting for TLS certificate"
+kubectl -n healthcare-platform wait --for=condition=Ready certificate/platform-tls --timeout=300s \
+  || echo "    not issued yet: kubectl -n healthcare-platform describe certificate platform-tls"
+
+echo
+echo "Done: https://$DOMAIN"
