diff --git a/infra/k8s/overlays/k3s/kustomization.yaml b/infra/k8s/overlays/k3s/kustomization.yaml
new file mode 100644
index 0000000..bb64f49
--- /dev/null
+++ b/infra/k8s/overlays/k3s/kustomization.yaml
@@ -0,0 +1,99 @@
+# Single-node k3s on a VPS, fronted by the F5 NGINX Ingress Controller with Let's Encrypt TLS.
+# Don't apply this directly — infra/k8s/scripts/deploy-to-k3s.sh layers the per-deploy values
+# (image tag, domain, TLS host, CORS origin) on top via a generated kustomization in
+# infra/k8s/.generated/k3s/.
+# See README.md in this directory.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - ../../base
+  - datastores/postgres.yaml
+  - datastores/redis.yaml
+  - datastores/zookeeper.yaml
+  - datastores/kafka.yaml
+  - datastores/rabbitmq.yaml
+  - datastores/minio.yaml
+  - datastores/payer-mock.yaml
+
+# One node, so one replica each.
+replicas:
+  - { name: identity-service, count: 1 }
+  - { name: patient-service, count: 1 }
+  - { name: doctor-service, count: 1 }
+  - { name: appointment-service, count: 1 }
+  - { name: emr-service, count: 1 }
+  - { name: billing-service, count: 1 }
+  - { name: notification-service, count: 1 }
+  - { name: audit-service, count: 1 }
+  - { name: analytics-service, count: 1 }
+  - { name: graphql-gateway, count: 1 }
+  - { name: frontend, count: 1 }
+
+# Real credentials, generated on the VPS by deploy-to-k3s.sh and never committed
+# (secrets.env is gitignored; secrets.env.example lists the keys). Replaces base's
+# placeholder Secret outright, so there's no apply-then-overwrite step like the AKS pipeline.
+secretGenerator:
+  - name: platform-secrets
+    namespace: healthcare-platform
+    behavior: replace
+    envs:
+      - secrets.env
+
+patches:
+  # Third-party payer endpoint -> in-cluster WireMock stub, same as dev.
+  - target: { kind: ConfigMap, name: platform-config }
+    patch: |-
+      apiVersion: v1
+      kind: ConfigMap
+      metadata:
+        name: platform-config
+      data:
+        PAYER_ELIGIBILITY_URL: "http://payer-mock.healthcare-platform.svc.cluster.local:8080/ws"
+
+  # F5 NGINX Ingress Controller annotations (nginx.org/*, not the retired community
+  # nginx.ingress.kubernetes.io/*):
+  #   - client-max-body-size matches emr-service's 25MB multipart limit (NGINX default is 1m).
+  #   - http01-edit-in-place makes cert-manager add the ACME challenge path to THIS Ingress.
+  #     Without it, cert-manager creates a second Ingress for the same host, and this
+  #     controller rejects it as a host collision — the challenge never gets routed.
+  #     Edit-in-place also makes cert-manager issue a temporary self-signed cert first, so the
+  #     controller's HTTP->HTTPS redirect works before the real cert exists.
+  - target: { kind: Ingress, name: platform-gateway }
+    patch: |-
+      apiVersion: networking.k8s.io/v1
+      kind: Ingress
+      metadata:
+        name: platform-gateway
+        annotations:
+          nginx.org/client-max-body-size: "25m"
+          cert-manager.io/cluster-issuer: letsencrypt
+          acme.cert-manager.io/http01-edit-in-place: "true"
+
+  # Images are built on the VPS and imported into k3s's containerd, never pulled.
+  - path: patches/image-pull-policy.yaml
+    target: { kind: Deployment, name: ".*-service|graphql-gateway|frontend" }
+
+  # Self-hosted PLAINTEXT Kafka, same gap and fix as dev/aks.
+  - path: patches/kafka-plaintext.yaml
+    target: { kind: Deployment, name: ".*-service" }
+
+  # No QRTZ_* tables provisioned, same as dev/aks.
+  - path: patches/quartz-memory.yaml
+    target: { kind: Deployment, name: analytics-service }
+
+  # Small VPSes have poor entropy; without this, JVM boot can stall for many minutes.
+  - path: patches/java-urandom.yaml
+    target: { kind: Deployment, name: ".*-service|graphql-gateway" }
+
+  - path: patches/vps-resources.yaml
+    target: { kind: Deployment, name: ".*-service|graphql-gateway" }
+
+  - path: patches/no-service-links.yaml
+    target: { kind: Deployment, name: ".*-service|graphql-gateway|frontend" }
+
+  # 10 JVMs cold-starting on a few vCPUs: base's 1s probe timeout kills healthy pods.
+  - path: patches/relaxed-probes.yaml
+    target: { kind: Deployment, name: ".*-service|graphql-gateway" }
+
+  - path: patches/emr-minio-auth.yaml
+    target: { kind: Deployment, name: emr-service }
