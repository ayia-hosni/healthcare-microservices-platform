<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.healthplatform</groupId>
  <artifactId>healthcare-platform</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Healthcare Platform (parent)</name>

  <modules>
    <module>grpc-contracts</module>
    <module>common</module>
    <module>identity-service</module>
    <module>patient-service</module>
    <module>doctor-service</module>
    <module>appointment-service</module>
    <module>emr-service</module>
    <module>billing-service</module>
    <module>notification-service</module>
    <module>audit-service</module>
    <module>analytics-service</module>
    <module>graphql-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.2</spring-boot.version>
    <springdoc.version>2.5.0</springdoc.version>
    <redoc.version>2.5.0</redoc.version>
    <jjwt.version>0.12.5</jjwt.version>
    <testcontainers.version>1.19.8</testcontainers.version>
    <!-- Spring Boot 3.3.2 manages Mockito 5.11.0 (Byte Buddy 1.14.18), which predates JDK 25 and
         cannot instrument classes on it ("Mockito cannot mock this class ..."). This build's local
         toolchain resolves to JDK 25, so every class-mocking unit test (not just the ones added
         here) fails at runtime without this bump. Overriding the version here is the standard
         Spring Boot pattern for pinning a managed dependency above the parent BOM's version. -->
    <mockito.version>5.20.0</mockito.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <grpc.version>1.63.0</grpc.version>
    <protobuf.version>3.25.3</protobuf.version>
    <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>
    <!-- HAPI FHIR R4: structures (Patient/Encounter/Condition/Observation/Bundle model classes,
         JSON parsing), client (IGenericClient, talks to an external FHIR server's REST API),
         and validation (FhirInstanceValidator against the bundled R4 base definitions — no
         network/terminology-server calls needed for structural + cardinality validation). Only
         emr-service uses these (see its pom.xml), not centrally BOM-imported here. -->
    <hapi-fhir.version>7.4.0</hapi-fhir.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <!--
            Without -parameters, Spring's SpEL-based annotations that reference method
            parameters by name (@Cacheable(key="#id"), @PreAuthorize, @RequestParam without an
            explicit name, etc.) can't resolve them at runtime — javac erases parameter names
            by default, so Spring falls back to reflection that only works with this flag on.
            Surfaced by PatientService/DoctorService's @Cacheable(key="#id") throwing
            "Null key returned for cache operation" under real Spring AOP proxying (a plain
            Mockito unit test never exercises the proxy, so it stayed invisible until an actual
            @Cacheable-backed integration test ran).
          -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <!--
            Mockito's inline mock maker (ByteBuddy) rejects class file versions newer than
            what it officially recognizes, which surfaces as "Java NN is not supported by the
            current version of Byte Buddy" on JVMs newer than ByteBuddy's known-good list.
            net.bytebuddy.experimental opts into best-effort support for those newer JVMs
            instead of hard-failing. Test-execution-only flag; does not affect production code.
          -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>-Dnet.bytebuddy.experimental=true</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
