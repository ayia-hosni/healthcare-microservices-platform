<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.healthplatform</groupId>
    <artifactId>healthcare-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>common</artifactId>
  <packaging>jar</packaging>
  <name>common</name>
  <description>Shared domain events, DTOs, and exception types used across all services</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Compile classpath only for the shared RedisCacheConfig bean (see cache/RedisCacheConfig.java)
         — optional so services that don't already pull spring-boot-starter-data-redis themselves
         (e.g. graphql-gateway) don't inherit an unused Redis dependency transitively. Its
         @ConditionalOnClass guard means the bean simply never activates for those services. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Shared JWT *verification* only (no signing key generation here) so every downstream
         service can validate access tokens issued by identity-service without duplicating
         the parsing logic. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Needed for the shared resource-server JWT filter (OncePerRequestFilter, GrantedAuthority) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- io.swagger.v3.oas.models classes only (no webmvc/UI) for the shared OpenApiConfig bean;
         every REST service pulls springdoc-openapi-starter-webmvc-api (spec generation only, see
         each service's pom) at the same ${springdoc.version}, so this stays in sync with those. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-common</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Self-hosted Redoc (docs UI) instead of Swagger UI: a webjar so it's resolved once from
         Maven Central and cached like any other dependency, no CDN <script> tag at request time.
         Landing in common/src/main/resources/static (see docs.html) means every service that
         depends on common gets /docs.html and /webjars/redoc/** for free — Spring Boot serves
         static resources from classpath:/META-INF/resources/ and classpath:/static/ across all
         jars on the classpath, not just the app's own module. -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>redoc</artifactId>
      <version>${redoc.version}</version>
      <!-- Only the pre-built bundles/redoc.standalone.js inside this jar is used; the npm
           package's own dependency graph (unresolvable version ranges on Maven Central for
           @redocly/config etc.) is irrelevant to serving a static file and breaks resolution
           if pulled in. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Needed for the shared outbox mechanism (OutboxEvent/OutboxEventRepository/OutboxRelay) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Generated gRPC stubs, shared by every service that depends on common the same way
         Topics.java/DomainEvent are the shared Kafka contract. The actual proto sources and
         codegen live in grpc-contracts (kept separate so graphql-gateway can depend on just
         the wire contracts without inheriting common's JPA/security/web dependencies); common
         re-exports it (non-optional) so existing com.healthplatform.common.grpc.* imports
         across appointment/doctor/patient-service keep working unchanged. -->
    <dependency>
      <groupId>com.healthplatform</groupId>
      <artifactId>grpc-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
